# Demo mode is the default; live mode uses OpenSky API and consumes API credits.
SOURCE_MODE=fixture
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Small UAE bounding box (<25 square degrees); review data provider terms.
OPENSKY_LAMIN=24.8
OPENSKY_LAMAX=25.3
OPENSKY_LOMIN=54.9
OPENSKY_LOMAX=55.6
POLL_INTERVAL_SECONDS=120
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=aviation.states.v1
SQLITE_PATH=data/dev/aviation.sqlite3
