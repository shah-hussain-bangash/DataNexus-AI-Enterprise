{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataNexus event envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "source",
    "source_event_time",
    "ingested_at",
    "tenant_id",
    "trace_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_event_time": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
