table Platform
	lineageTag: ef62289e-7b8a-4054-85df-d3ef417e357d

	measure 'Local Feeds' = MAX(Platform[local_feeds])
		formatString: 0
		displayFolder: Dashboard
		lineageTag: 24bd6ea0-c755-475d-a522-f7c50f654de9

	measure 'Catalog Feeds' = MAX(Platform[catalog_feeds])
		formatString: 0
		displayFolder: Dashboard
		lineageTag: 8addffcc-dab7-4853-9563-71dca3129b90

	measure 'Catalog Domains' = MAX(Platform[catalog_domains])
		formatString: 0
		displayFolder: Dashboard
		lineageTag: dc452427-bd60-4f82-8f26-4f40be86798c

	measure 'Aviation Events' = MAX(Platform[aviation_events])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 22e15169-0884-405b-be2a-45f684d62e96

	measure 'Aviation Aircraft' = MAX(Platform[aviation_aircraft])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 8e7f32b1-bc83-480b-9e39-17787ce1c598

	measure 'MTA Observations' = MAX(Platform[mta_observations])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 9d317517-6661-40e2-8adb-73262b7046e7

	measure 'Latest MTA Entities' = MAX(Platform[mta_latest_entities])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: bdd65dea-6c74-4ae4-bbab-881191c75f16

	measure 'Latest Trip Updates' = MAX(Platform[mta_latest_trip_updates])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 62a55b5c-2bd4-49ef-850e-71f7d7983e9f

	measure 'Latest Vehicle Positions' = MAX(Platform[mta_latest_vehicle_positions])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 476d4e40-fad3-4c8a-a8fe-f5912fe9ee78

	measure 'Verified Continuous Feeds' = MAX(Platform[continuous_feeds_verified])
		formatString: 0
		displayFolder: Dashboard
		lineageTag: 8298950b-dd6d-4ada-aafa-9c8664f3d008

	measure 'Integrity Checks' = MAX(Platform[integrity_checks_passed])
		formatString: 0
		displayFolder: Dashboard
		lineageTag: ae408db4-a819-4fc1-854b-192c4cdbdfe6

	measure 'Planned Feeds' = [Catalog Feeds] - [Local Feeds]
		formatString: 0
		displayFolder: Dashboard
		lineageTag: 1c7e3144-49d1-490e-9fc4-f1018718f0eb

	measure 'Release Evidence' = FORMAT(MAX(Platform[approved_controls]), "0") & " / " & FORMAT(MAX(Platform[required_controls]), "0")
		formatString: @
		displayFolder: Dashboard
		lineageTag: 61f744ff-1906-4f6e-bf53-f80f40f755fa

	measure 'Integrity Result' = FORMAT(MAX(Platform[integrity_checks_passed]), "0") & " / " & FORMAT(MAX(Platform[integrity_checks_total]), "0")
		formatString: @
		displayFolder: Dashboard
		lineageTag: 36227069-8ecf-4b2d-916b-be5db0c1fb2c

	measure 'Inventory Timestamp' = "Evidence captured (UTC): " & SUBSTITUTE(LEFT(MAX(Platform[captured_utc]),19), "T", " ")
		formatString: @
		displayFolder: Dashboard
		lineageTag: b2a6199b-1801-42b1-ab75-769710916ca5

	measure 'Telemetry Summary' = "MTA provider time (UTC): " & SUBSTITUTE(LEFT(MAX(Platform[mta_latest_provider_utc]),19), "T", " ") & UNICHAR(10) & "Aviation sample time (UTC): " & SUBSTITUTE(LEFT(MAX(Platform[aviation_latest]),19), "T", " ") & UNICHAR(10) & "Stored observations are historical evidence. Current provider or stream health is not established."
		formatString: @
		displayFolder: Dashboard
		lineageTag: 906a72db-c07d-41b4-a4ae-2c51a8fb9af7

	measure 'Release Narrative' = "Production release: " & MAX(Platform[release_status]) & " | Approved evidence: " & [Release Evidence] & UNICHAR(10) & "Local reporting integrity and production readiness are separate. Missing evidence is never treated as a passing control."
		formatString: @
		displayFolder: Dashboard
		lineageTag: 804d62a9-50d8-4569-b172-7a9bea433f43

