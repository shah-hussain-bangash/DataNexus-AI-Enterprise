	partition Platform = m
		mode: import
		source =
				let
				    Inventory = Json.Document(File.Contents(PowerBIDataRoot & "\DataNexus_Overview_Data.json")),
				    Rows = Table.FromRecords(Inventory[metrics]),
				    Typed = Table.TransformColumnTypes(Rows, {{"captured_utc", type text}, {"local_feeds", Int64.Type}, {"catalog_feeds", Int64.Type}, {"catalog_domains", Int64.Type}, {"approved_controls", Int64.Type}, {"required_controls", Int64.Type}, {"release_status", type text}, {"aviation_events", Int64.Type}, {"aviation_aircraft", Int64.Type}, {"aviation_positions", Int64.Type}, {"aviation_latest", type text}, {"mta_observations", Int64.Type}, {"mta_latest_entities", Int64.Type}, {"mta_latest_trip_updates", Int64.Type}, {"mta_latest_vehicle_positions", Int64.Type}, {"mta_latest_alerts", Int64.Type}, {"mta_latest_provider_utc", type text}, {"mta_latest_observed_utc", type text}, {"continuous_feeds_verified", Int64.Type}, {"integrity_checks_passed", Int64.Type}, {"integrity_checks_total", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

