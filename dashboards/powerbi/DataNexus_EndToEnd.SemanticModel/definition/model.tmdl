model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataNexus_Daily_Trips","Snapshot","QualityIssues","Platform","Sources","Pipeline","Services","ReleaseControls","Integrity","MTA","DomainCoverage","AviationDaily","SeismicEvents","WeatherDaily","CoastalHourly","RiverDaily","EnergyHourly","PropertyDaily"]

annotation PBI_ProTooling = ["DevMode"]

ref table DataNexus_Daily_Trips
ref table Snapshot
ref table QualityIssues
ref table Platform
ref table Sources
ref table Pipeline
ref table Services
ref table ReleaseControls
ref table Integrity
ref table MTA
ref table DomainCoverage
ref table AviationDaily
ref table SeismicEvents
ref table WeatherDaily
ref table CoastalHourly
ref table RiverDaily
ref table EnergyHourly
ref table PropertyDaily

ref cultureInfo en-US


ref expression DataNexusRoot
ref expression PowerBIDataRoot
